# Copy to .env.local and add your key to make grading + remediation use Gemini.
# Without a key, the app runs in MOCK mode (the loop is still walkable).
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
# Optional — a self-hosted SearXNG instance for course research (web-grounded,
# varied examples). Unset = research falls back to model-only (still works).
# e.g. http://localhost:8080
SEARXNG_URL=
